# Copy this file to azure-env/.env and fill in environment-specific values.

# Azure Service Bus configuration
SERVICE_BUS_CONNECTION_STRING=
COMMAND_TOPIC_NAME=commandtopic
COMMAND_SUBSCRIPTION_NAME=azuresubscription
REWARD_TOPIC_NAME=rewardtopic
REWARD_SUBSCRIPTION_NAME=webrewardsubscription

# Azure Active Directory service principal credentials (client secret flow)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# Optional: service principal certificate flow (use instead of AZURE_CLIENT_SECRET)
AZURE_CLIENT_CERTIFICATE_PATH=
AZURE_CLIENT_CERTIFICATE=
AZURE_CLIENT_CERTIFICATE_PASSWORD=

# Optional default subscription to select after login
AZURE_SUBSCRIPTION_ID=
