# DisGenerator Environment Variables Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# MODEL CONFIGURATION
# =============================================================================
# Base model for vLLM engine (from DisTrainer train_config.toml)
MODEL_NAME=Qwen/Qwen3-4B-Thinking-2507

# LoRA adapter from DisTrainer (relative to serving/ directory)
# This will be updated each RL step with the new policy
LORA_ADAPTER_PATH=serving/DisTrainer/checkpoints/Qwen3-4B-Thinking-Policy-v1/latest_adapter
LORA_ADAPTER_NAME=grpo-adapter

# =============================================================================
# DISAGGREGATED SERVER CONFIGURATION
# =============================================================================
# Prefill Server (GPUs 0,1)
PREFILL_HOST=localhost
PREFILL_PORT=8100

# Decode Server (GPUs 2,3)
DECODE_HOST=localhost
DECODE_PORT=8200

# =============================================================================
# GENERATION PARAMETERS
# =============================================================================
# Number of prompts to process per batch (higher = better GPU utilization)
PROMPTS_PER_BATCH=10

# Number of completions to generate per prompt
COMPLETIONS_PER_PROMPT=8

# Maximum tokens per completion
MAX_TOKENS_PER_COMPLETION=4096

# Maximum tool calling turns per completion
MAX_TURNS=8

# Sampling parameters
TEMPERATURE=0.7
TOP_P=0.9

# =============================================================================
# AZURE SERVICE BUS CONFIGURATION (REQUIRED for tool calls)
# =============================================================================
# Get this from your Azure Service Bus namespace
SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://your-namespace.servicebus.windows.net/;SharedAccessKeyName=your-policy;SharedAccessKey=your-key

# Topic/Subscription names (defaults provided)
COMMAND_TOPIC_NAME=commandtopic
REWARD_TOPIC_NAME=rewardtopic
WEB_SUBSCRIPTION_NAME=websubscription
CODE_SUBSCRIPTION_NAME=codesubscription
GRADER_SUBSCRIPTION_NAME=gradersubscription
GRADER_REWARD_SUBSCRIPTION_NAME=webrewardsubscription

# =============================================================================
# TIMEOUTS
# =============================================================================
TOOL_TIMEOUT_S=30
GRADER_TIMEOUT_S=60
REQUEST_TIMEOUT_S=120

# =============================================================================
# OUTPUT CONFIGURATION
# =============================================================================
OUTPUT_DIR=./data/generations
BATCHES_PER_FILE=1

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
DEBUG=0

# =============================================================================
# SYSTEM PROMPT
# =============================================================================
SYSTEM_PROMPT=You are an orchestrator agent. Decide when to use tools and when to answer directly. Use private reasoning between <think> and </think>; never reveal it. You may call only these tools: web.search(q, k), code.exec(cmd, cwd, timeout_s), azure.run(args[]). When you have the final answer, wrap it in <solution>your answer</solution> tags.

# =============================================================================
# NOTES
# =============================================================================
# 1. SERVICE_BUS_CONNECTION_STRING is required for tool functionality
# 2. Without it, tools will return mock responses (useful for testing)
# 3. For production, ensure 4 GPUs available (2 prefill + 2 decode)
# 4. Adjust PROMPTS_PER_BATCH based on your memory constraints
