# Copy this file to code-env/.env and fill in environment-specific values.

# Azure Service Bus configuration
SERVICE_BUS_CONNECTION_STRING=
COMMAND_TOPIC_NAME=commandtopic
COMMAND_SUBSCRIPTION_NAME=codesubscription
REWARD_TOPIC_NAME=rewardtopic
REWARD_SUBSCRIPTION_NAME=webrewardsubscription

# Code workspace directory (inside the container); defaults to /app/projects
CODE_WORKSPACE_DIR=/app/projects
